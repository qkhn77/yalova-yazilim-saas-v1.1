# PHPUnit / CI için örnek. Kopyalayıp .env.testing yapın veya ortam değişkeni verin.
APP_ENV=testing
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# SQLite (phpunit.xml varsayılanı ile uyumlu)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Alternatif: mevcut MySQL şemasında entegrasyon testi
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=yalova_kamera_test
# DB_USERNAME=root
# DB_PASSWORD=
